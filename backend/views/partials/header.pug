header.topbar
    .topbar-left
        .brand
            .brand-logo N
            div
                .brand-name Northline PC
                .brand-sub ERP · Kho · Sản xuất

        .topbar-breadcrumb.d-none.d-lg-block
            | Northline PC /
            strong  #{pageTitle || 'Dashboard'}

    .topbar-center
        .input-group.topbar-search-wrap
            span.input-group-text
                i.bi.bi-search
            input.form-control.topbar-search(type="text" placeholder="Tìm linh kiện, phiếu, BOM...")

    .topbar-right
        button.topbar-icon-btn(type="button")
            i.bi.bi-bell
            span.dot

        .dropdown
            a.topbar-user(href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false")
                .topbar-user-avatar #{user.fullName ? user.fullName.trim().charAt(0).toUpperCase() : 'U'}
                div.d-none.d-md-block
                    .topbar-user-name #{user.fullName}
                    .topbar-user-role
                        if user.role === 'admin'
                            | Quản trị viên
                        else if user.role === 'warehouse_manager'
                            | Quản lý kho
                        else if user.role === 'staff'
                            | Nhân viên lắp ráp
                        else
                            | #{user.role}
                i.bi.bi-chevron-down.text-muted.small

            ul.dropdown-menu.dropdown-menu-end.topbar-user-menu
                li
                    a.dropdown-item(href="/profile")
                        i.bi.bi-person.me-2
                        | Thông tin cá nhân
                li
                    hr.dropdown-divider
                li
                    form(action=`${prefixAdmin}/auth/logout` method="POST" id="form-logout")
                        button.dropdown-item.text-danger(type="submit")
                            i.bi.bi-box-arrow-right.me-2
                            | Đăng xuất
        

