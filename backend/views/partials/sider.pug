aside.sider
    - const perms = user && user.permissions ? user.permissions : []
    if perms.includes('components_view') || perms.includes('importOrders_view') || perms.includes('exportOrders_view') || perms.includes('bom_view')
        .section-label VẬN HÀNH
        nav.side-nav
            if perms.includes('components_view')
                a.nav-item(href=`${prefixAdmin}/components`)
                    i.bi.bi-diagram-3
                    span.nav-label Linh kiện

            if perms.includes('importOrders_view')
                a.nav-item(href=`${prefixAdmin}/importOrders`)
                    i.bi.bi-box-arrow-in-down-left
                    span.nav-label Phiếu nhập

            if perms.includes('exportOrders_view')
                a.nav-item(href=`${prefixAdmin}/exportOrders`)
                    i.bi.bi-box-arrow-up-right
                    span.nav-label Phiếu xuất

            if perms.includes('bom_view')
                a.nav-item(href=`${prefixAdmin}/bom`)
                    i.bi.bi-clipboard-data
                    span.nav-label BOM / Cấu hình PC

    if perms.includes('account_view') || perms.includes('roles_view')
        .section-label HỆ THỐNG
        nav.side-nav
            if perms.includes('account_view')
                a.nav-item(href=`${prefixAdmin}/accounts`)
                    i.bi.bi-people
                    span.nav-label Người dùng

            if perms.includes('roles_view')
                a.nav-item(href=`${prefixAdmin}/permissions`)
                    i.bi.bi-shield-check
                    span.nav-label Phân quyền
