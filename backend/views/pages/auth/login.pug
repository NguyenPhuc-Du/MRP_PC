doctype html
html(lang="vi")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Đăng nhập hệ thống

        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
        link(rel="stylesheet" href="/css/login.css")

    body
        .login-wrap
            .login-card
                .login-icon
                    i.bi.bi-key-fill

                h1.login-title Đăng nhập hệ thống
                p.login-sub Sử dụng tài khoản được cấp để tiếp tục.

                form#form-login(action="/login" method="POST")
                    .form-group-custom
                        label.form-label-custom(for="username") Tên đăng nhập
                        .input-icon-wrap
                            i.bi.bi-person
                            input#username.form-control.input-custom(
                                type="text"
                                name="username"
                                placeholder="Nhập tên đăng nhập"
                                autocomplete="username"
                                required
                            )

                    .form-group-custom
                        label.form-label-custom(for="password") Mật khẩu
                        .input-icon-wrap
                            i.bi.bi-lock
                            input#password.form-control.input-custom(
                                type="password"
                                name="password"
                                placeholder="Nhập mật khẩu"
                                autocomplete="current-password"
                                required
                            )
                            button.password-toggle(type="button" data-target="#password")
                                i.bi.bi-eye-slash

                    button.btn-login(type="submit")
                        i.bi.bi-box-arrow-in-right
                        span Đăng nhập

                p.login-footer cần hỗ trợ truy cập · liên hệ quản trị viên hệ thống

        script(src="/js/login.js")
