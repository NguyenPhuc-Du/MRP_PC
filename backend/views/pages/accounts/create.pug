extends ../../layouts/admin-layout.pug
include ../../mixins/alert.pug

block main
    link(rel="stylesheet" href="/css/account.css")

    +alert-success(4000)
    +alert-error(6000)

    .page-head
        div
            .page-eyebrow Tài khoản
            h2.page-title Tạo tài khoản mới
            p.page-desc Thêm người dùng vào hệ thống và phân quyền truy cập.
        .page-actions
            a.btn-soft(href="/admin/accounts")
                i.bi.bi-arrow-left
                span Quay lại

    form#form-create-account(action="/admin/accounts/create" method="POST")
        .row.g-4
            .col-lg-8
                //- --- Thông tin đăng nhập ---
                .form-card
                    .form-card-head
                        .form-card-icon
                            i.bi.bi-person-badge
                        div
                            .form-card-title Thông tin đăng nhập
                            .form-card-sub Tên đăng nhập và mật khẩu truy cập hệ thống.

                    .row.g-3
                        .col-md-6
                            label.form-label-custom(for="username")
                                | Tên đăng nhập
                                span.required *
                            input#username.form-control.input-custom(
                                type="text"
                                name="username"
                                maxlength="50"
                                placeholder="vd: lehoang"
                                value=oldInput.username
                                required
                            )
                            .form-hint Tối đa 50 ký tự, không trùng với tài khoản khác.

                        .col-md-6
                            label.form-label-custom(for="email") Email
                            input#email.form-control.input-custom(
                                type="email"
                                name="email"
                                maxlength="100"
                                placeholder="vd: lehoang@northline.vn"
                                value=oldInput.email
                            )
                            .form-hint Dùng để khôi phục mật khẩu và nhận thông báo.

                        .col-md-6
                            label.form-label-custom(for="password")
                                | Mật khẩu
                                span.required *
                            .password-wrap
                                input#password.form-control.input-custom(
                                    type="password"
                                    name="password"
                                    minlength="6"
                                    placeholder="Ít nhất 6 ký tự"
                                    required
                                )
                                button.password-toggle(type="button" data-target="#password")
                                    i.bi.bi-eye

                        .col-md-6
                            label.form-label-custom(for="confirmPassword")
                                | Xác nhận mật khẩu
                                span.required *
                            .password-wrap
                                input#confirmPassword.form-control.input-custom(
                                    type="password"
                                    name="confirmPassword"
                                    minlength="6"
                                    placeholder="Nhập lại mật khẩu"
                                    required
                                )
                                button.password-toggle(type="button" data-target="#confirmPassword")
                                    i.bi.bi-eye

                //- --- Thông tin cá nhân ---
                .form-card
                    .form-card-head
                        .form-card-icon
                            i.bi.bi-person-lines-fill
                        div
                            .form-card-title Thông tin cá nhân
                            .form-card-sub Dùng để hiển thị trong hệ thống và liên hệ.

                    .row.g-3
                        .col-md-6
                            label.form-label-custom(for="fullName") Họ và tên
                            input#fullName.form-control.input-custom(
                                type="text"
                                name="fullName"
                                maxlength="100"
                                placeholder="vd: Lê Hoàng"
                                value=oldInput.fullName
                            )

                        .col-md-6
                            label.form-label-custom(for="phone") Số điện thoại
                            input#phone.form-control.input-custom(
                                type="tel"
                                name="phone"
                                maxlength="20"
                                placeholder="vd: 0901 234 567"
                                value=oldInput.phone
                            )

            //- ===== Cột phải: phân quyền =====
            .col-lg-4
                //- --- Vai trò ---
                .form-card
                    .form-card-head
                        .form-card-icon
                            i.bi.bi-shield-lock
                        div
                            .form-card-title Vai trò
                            .form-card-sub Quyết định phạm vi thao tác.

                    .role-list
                        label.role-option
                            input(type="radio" name="role" value="admin" checked=(oldInput.role === "admin") required)
                            span.role-body
                                span.role-name Quản trị viên
                                span.role-desc Toàn quyền trên hệ thống.
                            i.bi.bi-check-circle-fill.role-check

                        label.role-option
                            input(type="radio" name="role" value="warehouse_manager" checked=(oldInput.role ? oldInput.role === "warehouse_manager" : true))
                            span.role-body
                                span.role-name Quản lý kho
                                span.role-desc Duyệt phiếu nhập, xuất và tồn kho.
                            i.bi.bi-check-circle-fill.role-check

                        label.role-option
                            input(type="radio" name="role" value="staff" checked=(oldInput.role === "staff"))
                            span.role-body
                                span.role-name Nhân viên
                                span.role-desc Tạo phiếu và xem dữ liệu được giao.
                            i.bi.bi-check-circle-fill.role-check

                //- --- Trạng thái ---
                .form-card
                    .form-card-head
                        .form-card-icon
                            i.bi.bi-toggle-on
                        div
                            .form-card-title Trạng thái
                            .form-card-sub Tài khoản bị khoá không thể đăng nhập.

                    select#status.form-select.input-custom(name="status")
                        option(value="active" selected=(oldInput.status !== "locked")) Đang hoạt động
                        option(value="locked" selected=(oldInput.status === "locked")) Đã khoá

                    .status-note
                        i.bi.bi-info-circle
                        span Mặc định tài khoản mới ở trạng thái hoạt động.

                //- --- Nút hành động ---
                .form-actions
                    button.btn-gradient(type="submit")
                        i.bi.bi-check-lg
                        span Tạo tài khoản
                    button.btn-soft.w-100(type="reset")
                        i.bi.bi-arrow-counterclockwise
                        span Nhập lại

    script(src="/js/account.js")