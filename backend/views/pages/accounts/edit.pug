extends ../../layouts/admin-layout.pug
include ../../mixins/alert.pug

block main
    link(rel="stylesheet" href="/css/account.css")

    +alert-success(4000)
    +alert-error(6000)

    .page-head
        div
            .page-eyebrow Tài khoản
            h2.page-title Chỉnh sửa tài khoản
            p.page-desc Cập nhật thông tin và phân quyền của người dùng.
        .page-actions
            a.btn-soft(href="/admin/accounts")
                i.bi.bi-arrow-left
                span Quay lại

    form#form-edit-account(action=`${prefixAdmin}/accounts/edit/${account.id}?_method=PATCH` method="POST")
        .row.g-4
            .col-lg-8
                //- --- Thông tin đăng nhập ---
                .form-card
                    .form-card-head
                        .form-card-icon
                            i.bi.bi-person-badge
                        div
                            .form-card-title Thông tin đăng nhập
                            .form-card-sub Tên đăng nhập và mật khẩu truy cập hệ thống.

                    .row.g-3
                        .col-md-6
                            label.form-label-custom(for="username")
                                | Tên đăng nhập
                                span.required *
                            input#username.form-control.input-custom(
                                type="text"
                                name="username"
                                maxlength="50"
                                placeholder="vd: lehoang"
                                value=(oldInput.username || account.username)
                                required
                            )
                            .form-hint Tối đa 50 ký tự, không trùng với tài khoản khác.

                        .col-md-6
                            label.form-label-custom(for="email") Email
                            input#email.form-control.input-custom(
                                type="email"
                                name="email"
                                maxlength="100"
                                placeholder="vd: lehoang@northline.vn"
                                value=(oldInput.email || account.email)
                            )
                            .form-hint Dùng để khôi phục mật khẩu và nhận thông báo.

                        .col-md-6
                            label.form-label-custom(for="password") Mật khẩu
                            .password-wrap
                                input#password.form-control.input-custom(
                                    type="password"
                                    name="password"
                                    minlength="6"
                                    placeholder="Để trống nếu không đổi"
                                )
                                button.password-toggle(type="button" data-target="#password")
                                    i.bi.bi-eye
                            .form-hint Chỉ nhập nếu muốn đặt mật khẩu mới.

                        .col-md-6
                            label.form-label-custom(for="confirmPassword") Xác nhận mật khẩu
                            .password-wrap
                                input#confirmPassword.form-control.input-custom(
                                    type="password"
                                    name="confirmPassword"
                                    minlength="6"
                                    placeholder="Nhập lại mật khẩu mới"
                                )
                                button.password-toggle(type="button" data-target="#confirmPassword")
                                    i.bi.bi-eye

                //- --- Thông tin cá nhân ---
                .form-card
                    .form-card-head
                        .form-card-icon
                            i.bi.bi-person-lines-fill
                        div
                            .form-card-title Thông tin cá nhân
                            .form-card-sub Dùng để hiển thị trong hệ thống và liên hệ.

                    .row.g-3
                        .col-md-6
                            label.form-label-custom(for="fullName") Họ và tên
                            input#fullName.form-control.input-custom(
                                type="text"
                                name="fullName"
                                maxlength="100"
                                placeholder="vd: Lê Hoàng"
                                value=(oldInput.fullName || account.fullName)
                            )

                        .col-md-6
                            label.form-label-custom(for="phone") Số điện thoại
                            input#phone.form-control.input-custom(
                                type="tel"
                                name="phone"
                                maxlength="20"
                                placeholder="vd: 0901 234 567"
                                value=(oldInput.phone || account.phone)
                            )

            //- ===== Cột phải: phân quyền =====
            .col-lg-4
                //- --- Vai trò ---
                .form-card
                    .form-card-head
                        .form-card-icon
                            i.bi.bi-shield-lock
                        div
                            .form-card-title Vai trò
                            .form-card-sub Quyết định phạm vi thao tác.

                    .role-list
                        if account.role === "admin"
                            input(type="hidden" name="role" value="admin")
                            label.role-option
                                input(type="radio" name="role" value="admin" checked disabled)
                                span.role-body
                                    span.role-name Quản trị viên
                                    span.role-desc Không thể đổi vai trò của quản trị viên duy nhất.
                                i.bi.bi-check-circle-fill.role-check
                        else
                            if !adminExists
                                label.role-option
                                    input(type="radio" name="role" value="admin" checked=((oldInput.role || account.role) === "admin") required)
                                    span.role-body
                                        span.role-name Quản trị viên
                                        span.role-desc Toàn quyền trên hệ thống.
                                    i.bi.bi-check-circle-fill.role-check

                            label.role-option
                                input(type="radio" name="role" value="warehouse_manager" checked=((oldInput.role || account.role) === "warehouse_manager") required)
                                span.role-body
                                    span.role-name Quản lý kho
                                    span.role-desc Duyệt phiếu nhập, xuất và tồn kho.
                                i.bi.bi-check-circle-fill.role-check

                            label.role-option
                                input(type="radio" name="role" value="staff" checked=((oldInput.role || account.role) === "staff"))
                                span.role-body
                                    span.role-name Nhân viên
                                    span.role-desc Tạo phiếu và xem dữ liệu được giao.
                                i.bi.bi-check-circle-fill.role-check

                //- --- Trạng thái ---
                .form-card
                    .form-card-head
                        .form-card-icon
                            i.bi.bi-toggle-on
                        div
                            .form-card-title Trạng thái
                            .form-card-sub Tài khoản bị khoá không thể đăng nhập.

                    if account.role === "admin"
                        input(type="hidden" name="status" value="active")
                        select#status.form-select.input-custom(disabled)
                            option(value="active" selected) Đang hoạt động
                        .status-note
                            i.bi.bi-info-circle
                            span Không thể khóa tài khoản admin.
                    else
                        select#status.form-select.input-custom(name="status")
                            option(value="active" selected=((oldInput.status || account.status) === "active")) Đang hoạt động
                            option(value="locked" selected=((oldInput.status || account.status) === "locked")) Đã khoá

                        .status-note
                            i.bi.bi-info-circle
                            span Khoá tài khoản sẽ chặn đăng nhập ngay lập tức.

                //- --- Nút hành động ---
                .form-actions
                    button.btn-gradient(type="submit")
                        i.bi.bi-check-lg
                        span Lưu thay đổi
                    a.btn-soft.w-100(href="/admin/accounts")
                        i.bi.bi-x-lg
                        span Huỷ

    script(src="/js/account.js")