extends ../../layouts/admin-layout.pug

block main
  .comp-page
    .d-flex.justify-content-between.align-items-start.mb-4
      div
        .comp-eyebrow DANH MỤC
        h4.fw-bold.mb-1 Quản lý linh kiện
        .text-secondary.small 1264 linh kiện thuộc kho cơ sở
      button.btn.comp-btn.comp-btn-light
        i.bi.bi-box-arrow-in-down
        | Import

    .comp-card
      .d-flex.flex-wrap.align-items-center.gap-2.mb-4
        .input-group.comp-search.flex-grow-1
          span.input-group-text
            i.bi.bi-search
          input.form-control(type="text" placeholder="Tìm kiếm theo mã hoặc tên...")

        button.btn.comp-btn.comp-btn-light
          i.bi.bi-funnel
          | Bộ lọc
        button.btn.comp-btn.comp-btn-icon
          i.bi.bi-layout-sidebar
        button.btn.comp-btn.comp-btn-light
          i.bi.bi-download
          | Xuất
        button.btn.comp-btn.comp-btn-primary
          i.bi.bi-plus-lg
          | Thêm linh kiện

