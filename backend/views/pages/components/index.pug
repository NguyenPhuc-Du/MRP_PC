extends ../../layouts/admin-layout.pug
include ../../mixins/pagination.pug
include ../../mixins/alert.pug
block main
  +alert-success(4000)
  +alert-error(6000)
  .comp-page
    .d-flex.justify-content-between.align-items-start.mb-4
      div
        .comp-eyebrow DANH MỤC 
        h4.fw-bold.mb-1 Quản lý linh kiện
        .text-secondary.small #{totalComponents} linh kiện thuộc kho cơ sở
      button.btn.comp-btn.comp-btn-light
    .comp-card
      .d-flex.flex-wrap.align-items-center.gap-2.mb-4
        form#form-search.comp-search.flex-grow-1(method="get" action=`${prefixAdmin}/components`)
          .input-group
            span.input-group-text
              i.bi.bi-search
            input.form-control(
              type="text"
              name="keyword"
              placeholder="Tìm kiếm theo tên..."
              value=keyword || ""
            )
            button.btn.btn-success(type="submit") Tìm
        div.d-flex.align-items-center.gap-2
          select.form-select(name="status" id="form-status")
            option(value="all" selected=status === "all") Tất cả
            option(value="active" selected=status === "active") Đang kinh doanh 
            option(value="discontinued" selected=status === "discontinued") Ngừng kinh doanh 
        if user && user.permissions && user.permissions.includes('components_create')
          a.btn.comp-btn.comp-btn-primary(href=`${prefixAdmin}/components/create`)
            | Thêm linh kiện

      .table-responsive.comp-table-wrap
        table.table.table-borderless.align-middle.mb-0.comp-table
          thead
            tr
              th MÃ LINH KIỆN
              th TÊN LINH KIỆN
              th LOẠI
              th THƯƠNG HIỆU
              th NHÀ CUNG CẤP
              th ĐVT
              th TỒN KHO
              th TỐI THIỂU
              th GIÁ NHẬP
              th TRẠNG THÁI
              th CẬP NHẬT
              th Hành động
          tbody
            if components && components.length
              each component in components
                tr
                  td
                    span.comp-code= component.code
                  td
                    .comp-name-cell
                      if component.imageUrl
                        img.comp-thumb(src=component.imageUrl alt=component.name)
                      span.comp-name= component.name
                  td.comp-muted= component.category
                  td.comp-muted —
                  td.comp-muted —
                  td.comp-muted= component.unit
                  td.comp-stock= component.quantityOnHand
                  td.comp-muted= component.minStockThreshold
                  td.comp-muted= component.unitPrice
                  td
                    span.comp-status(class=`comp-status-${component.stockStatus}`)
                      span.comp-dot
                      | #{component.stockLabel}
                  td.comp-muted= formatDate(component.createdAt)
                  if user && user.permissions && (user.permissions.includes('components_edit') || user.permissions.includes('components_delete'))
                    td
                      if user.permissions.includes('components_edit')
                        a(
                          href=`${prefixAdmin}/components/edit/${component.id}`
                          class="btn btn-warning btn-sm"
                          ) Sửa
                      if user.permissions.includes('components_delete')
                        button(class="btn btn-danger btn-sm ml-1" button-delete data-id=component.id) Xóa 
            else
              tr
                td.text-center.text-secondary.py-4(colspan="11") Chưa có linh kiện nào.

      .d-flex.justify-content-between.align-items-center.mt-4
        .text-secondary.small
          if totalComponents
            | Hiển thị 1-#{objectPagination.limit} trong #{totalComponents}
          else
            | Không có dữ liệu
        nav
          +pagination(objectPagination)
    form(
    action=""
    method="POST"
    id="form-delete-item"
    data-path=`${prefixAdmin}/components/delete`
  )
  script(src="/js/components.js")
