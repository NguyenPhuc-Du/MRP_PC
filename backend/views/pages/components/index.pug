extends ../../layouts/admin-layout.pug
include ../../mixins/pagination.pug
block main
  .comp-page
    .d-flex.justify-content-between.align-items-start.mb-4
      div
        .comp-eyebrow DANH MỤC
        h4.fw-bold.mb-1 Quản lý linh kiện
        .text-secondary.small #{totalComponents} linh kiện thuộc kho cơ sở
      button.btn.comp-btn.comp-btn-light
        i.bi.bi-box-arrow-in-down
        | Import

    .comp-card
      .d-flex.flex-wrap.align-items-center.gap-2.mb-4
        .input-group.comp-search.flex-grow-1
          span.input-group-text
            i.bi.bi-search
          input.form-control(type="text" placeholder="Tìm kiếm theo mã hoặc tên...")

        button.btn.comp-btn.comp-btn-light
          i.bi.bi-funnel
          | Bộ lọc
        button.btn.comp-btn.comp-btn-icon
          i.bi.bi-layout-sidebar
        button.btn.comp-btn.comp-btn-light
          i.bi.bi-download
          | Xuất
        button.btn.comp-btn.comp-btn-primary
          i.bi.bi-plus-lg
          | Thêm linh kiện

      .table-responsive.comp-table-wrap
        table.table.table-borderless.align-middle.mb-0.comp-table
          thead
            tr
              th MÃ LINH KIỆN
              th TÊN LINH KIỆN
              th LOẠI
              th THƯƠNG HIỆU
              th NHÀ CUNG CẤP
              th ĐVT
              th TỒN KHO
              th TỐI THIỂU
              th GIÁ NHẬP
              th TRẠNG THÁI
              th CẬP NHẬT
              th Hành động
          tbody
            if components && components.length
              each component in components
                tr
                  td
                    span.comp-code= component.code
                  td
                    .comp-name-cell
                      if component.imageUrl
                        img.comp-thumb(src=component.imageUrl alt=component.name)
                      span.comp-name= component.name
                  td.comp-muted= component.category
                  td.comp-muted —
                  td.comp-muted —
                  td.comp-muted= component.unit
                  td.comp-stock= component.quantityOnHand
                  td.comp-muted= component.minStockThreshold
                  td.comp-muted= component.unitPrice
                  td
                    span.comp-status(class=`comp-status-${component.stockStatus}`)
                      span.comp-dot
                      | #{component.stockLabel}
                  td.comp-muted= formatDate(component.createdAt)
                  td  
                    button.btn.comp-btn.comp-btn-icon
                      i.bi.bi-pencil
                    button.btn.comp-btn.comp-btn-icon
                      i.bi.bi-trash 
            else
              tr
                td.text-center.text-secondary.py-4(colspan="11") Chưa có linh kiện nào.

      .d-flex.justify-content-between.align-items-center.mt-4
        .text-secondary.small
          if totalComponents
            | Hiển thị 1-#{totalComponents} trong #{totalComponents}
          else
            | Không có dữ liệu
        nav
          +pagination(objectPagination)
  script(src="/js/components.js")
