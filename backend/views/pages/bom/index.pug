extends ../../layouts/admin-layout.pug
include ../../mixins/alert.pug
include ../../mixins/pagination.pug

block main
    link(rel="stylesheet" href="/css/bom.css")
    +alert-success(4000)
    +alert-error(6000)

    .bom-page
        .bom-head
            div
                .bom-eyebrow CÔNG THỨC SẢN PHẨM
                h1.bom-title BOM / Cấu hình PC
                p.bom-desc Định nghĩa linh kiện và số lượng để lắp từng cấu hình máy.
            if user && user.permissions && user.permissions.includes('bom_create')
                a.bom-btn-primary(href=`${prefixAdmin}/bom/create`)
                    i.bi.bi-plus-lg
                    span Thêm cấu hình

        .bom-card
            form.bom-toolbar(method="GET" action=`${prefixAdmin}/bom`)
                .bom-search
                    i.bi.bi-search
                    input(type="text" placeholder="Tìm theo tên cấu hình hoặc mã BOM...")
                .bom-toolbar-actions
                    .dropdown
                        button.bom-btn-ghost.dropdown-toggle(
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        )
                            i.bi.bi-funnel
                            span Bộ lọc
                        ul.dropdown-menu.dropdown-menu-end
                            li
                                a.dropdown-item(
                                    class=(!sort ? "active" : "")
                                    href=`${prefixAdmin}/bom`
                                ) Mặc định
                            li
                                a.dropdown-item(
                                    class=(sort === "price_asc" ? "active" : "")
                                    href=`${prefixAdmin}/bom?sort=price_asc`
                                ) Giá tăng dần
                            li
                                a.dropdown-item(
                                    class=(sort === "price_desc" ? "active" : "")
                                    href=`${prefixAdmin}/bom?sort=price_desc`
                                ) Giá giảm dần

            .table-responsive
                table.bom-table
                    thead
                        tr
                            th HÌNH ẢNH
                            th TÊN CẤU HÌNH
                            th MÃ BOM
                            th VERSION
                            th LINH KIỆN
                            th GIÁ VỐN
                            th GIÁ BÁN CUỐI
                            th TRẠNG THÁI
                            if user && user.permissions && user.permissions.includes('bom_view')
                                th
                    tbody
                        if configs && configs.length
                            each config in configs
                                tr
                                    td
                                        if config.imageUrl
                                            img.bom-thumb(src=config.imageUrl alt=config.name)
                                        else
                                            span.bom-thumb.is-empty
                                    td
                                        if user && user.permissions && user.permissions.includes('bom_view')
                                            a.bom-name(href=`${prefixAdmin}/bom/detail/${config.id}`)= config.name
                                        else
                                            span.bom-name.fw-bold= config.name
                                    td
                                        span.bom-code= config.code
                                    td= config.version
                                    td #{config.itemCount} linh kiện · #{config.groupCount} nhóm
                                    td.bom-money= config.totalCostText
                                    td.bom-money
                                      if config.saleLocked
                                        span.is-locked= config.salePriceText
                                      else
                                        span.is-open= config.salePriceText || "Chưa chốt"
                                    td
                                        span.bom-status(class=`is-${config.status}`)
                                            span.bom-status-dot
                                            | #{config.statusLabel}
                                    if user && user.permissions && user.permissions.includes('bom_view')
                                        td
                                            a.bom-more(href=`${prefixAdmin}/bom/detail/${config.id}` title="Xem BOM")
                                                i.bi.bi-arrow-right
                        else
                            tr
                                - const canView = user && user.permissions && user.permissions.includes('bom_view');
                                - const canCreate = user && user.permissions && user.permissions.includes('bom_create');
                                td.text-center.py-4(colspan=canView ? "9" : "8")
                                    | Chưa có cấu hình BOM. #{canCreate ? 'Bấm “Thêm cấu hình” để tạo mới.' : ''}

            .d-flex.justify-content-between.align-items-center.mt-4
                .text-secondary.small
                    if totalConfigs
                        | Hiển thị #{objectPagination.skipPage + 1}-#{objectPagination.skipPage + configs.length} trong #{totalConfigs}
                    else
                        | Không có dữ liệu
                if objectPagination
                    nav
                        +pagination(objectPagination)

block script
    script(src="/js/script.js")
    script(src="/js/bom.js")
