extends ../../layouts/admin-layout.pug
include ../../mixins/alert.pug

block main
  link(rel="stylesheet" href="/css/dashboard.css")
  +alert-success(4000)
  +alert-error(6000)

  if !dashboard
    .dash-page
      .dash-empty Không tải được dữ liệu dashboard.
  else
    .dash-page
      .dash-head
        div
          .dash-date= dashboard.dateLabel
          h2.dash-title Xưởng lắp ráp · Tổng quan
          p.dash-desc Theo dõi kho linh kiện và thành phẩm theo thời gian thực.
        .dash-actions
          .dash-export
            span.dash-export-label
              i.bi.bi-download
              | Xuất báo cáo
            a.dash-btn-ghost(href=`${prefixAdmin}/dashboard/export.xlsx`)
              i.bi.bi-file-earmark-excel
              span Excel
            a.dash-btn-ghost(href=`${prefixAdmin}/dashboard/export.pdf`)
              i.bi.bi-file-earmark-pdf
              span PDF

      .dash-kpis
        .dash-kpi
          .dash-kpi-label
            span Tổng linh kiện
          .dash-kpi-value= dashboard.metrics.components.value
          .dash-kpi-hint.is-up= dashboard.metrics.components.hint
        .dash-kpi
          .dash-kpi-label
            span Giá trị tồn kho
          .dash-kpi-value= dashboard.metrics.stockValue.value
          .dash-kpi-hint.is-up= dashboard.metrics.stockValue.hint
        .dash-kpi
          .dash-kpi-label
            span Phiếu nhập hôm nay
          .dash-kpi-value= dashboard.metrics.importToday.value
          .dash-kpi-hint= dashboard.metrics.importToday.hint
        .dash-kpi
          .dash-kpi-label
            span Xuất chờ duyệt
          .dash-kpi-value= dashboard.metrics.exportPending.value
          .dash-kpi-hint.is-warn= dashboard.metrics.exportPending.hint
        .dash-kpi
          .dash-kpi-label
            span Cấu hình PC
          .dash-kpi-value= dashboard.metrics.pcConfigs.value
          .dash-kpi-hint= dashboard.metrics.pcConfigs.hint
        .dash-kpi
          .dash-kpi-label
            span Thành phẩm đã lắp
          .dash-kpi-value= dashboard.metrics.finished.value
          .dash-kpi-hint.is-up= dashboard.metrics.finished.hint
        .dash-kpi
          .dash-kpi-label
            span Sắp hết
          .dash-kpi-value= dashboard.metrics.lowStock.value
          .dash-kpi-hint.is-warn= dashboard.metrics.lowStock.hint

      .dash-mid
        .dash-card.dash-chart-card
          .dash-card-head
            div
              .dash-card-title Nhập / xuất linh kiện
              .dash-card-sub 6 ngày gần nhất, số lượng trên phiếu
            .dash-legend
              span.dash-dot.is-in Nhập
              span.dash-dot.is-out Xuất
          .dash-chart-wrap
            canvas#dash-chart
          script#dashboard-chart-data(type="application/json")!= JSON.stringify(dashboard.chart)

        .dash-card
          .dash-card-head
            .dash-card-title Cảnh báo tồn kho
            if dashboard.alerts.length
              span.dash-pill Sắp hết · #{dashboard.alerts.length}
          if dashboard.alerts.length
            each alert in dashboard.alerts
              .dash-alert
                div
                  .dash-alert-name= alert.name
                  .dash-alert-meta= alert.meta
                span.dash-alert-qty= alert.qty
          else
            .dash-empty-sm Không có linh kiện dưới ngưỡng.

      .dash-bot
        .dash-card
          .dash-card-head
            div
              .dash-card-title Top linh kiện sử dụng nhiều
              .dash-card-sub= dashboard.topCaption
          .table-responsive
            table.dash-table
              thead
                tr
                  th Linh kiện
                  th Nhóm
                  th Đã dùng
                  th Tồn kho
                  th Trạng thái
              tbody
                if dashboard.topItems.length
                  each item in dashboard.topItems
                    tr
                      td.dash-name= item.name
                      td= item.group
                      td= item.used
                      td= item.stock
                      td
                        span.dash-stock(class=`is-${item.stockKey}`)
                          span.dash-stock-dot
                          | #{item.stockLabel}
                else
                  tr
                    td(colspan="5")
                      .dash-empty-sm Chưa có linh kiện được xuất.

        .dash-card
          .dash-card-head
            .dash-card-title Hoạt động gần đây
          if dashboard.activity.length
            each item in dashboard.activity
              .dash-act(class=`is-${item.tone}`)
                span.dash-act-dot
                div
                  .dash-act-title= item.title
                  .dash-act-detail= item.detail
          else
            .dash-empty-sm Chưa có hoạt động.

block script
  script(src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js")
  script(src="/js/dashboard.js")
