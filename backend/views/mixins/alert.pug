mixin flash-item(kind, title, text, time)
    .flash-wrap
        .flash(class=`flash-${kind}` show-alert data-time=time role="status")
            .flash-icon
                if kind == "success"
                    i.bi.bi-check-lg
                else if kind == "warning"
                    i.bi.bi-exclamation-triangle-fill
                else
                    i.bi.bi-exclamation-lg
            .flash-body
                .flash-title= title
                .flash-text= text
            button.flash-close(type="button" close-alert aria-label="Đóng")
                i.bi.bi-x-lg

mixin alert-success(time)
    - if (messages.success)
        - const successText = Array.isArray(messages.success) ? messages.success.join(". ") : messages.success
        +flash-item("success", "Thành công", successText, time)

mixin alert-error(time)
    - if (messages.error)
        - const errorText = Array.isArray(messages.error) ? messages.error.join(". ") : messages.error
        +flash-item("error", "Có lỗi xảy ra", errorText, time)

mixin alert-warning(time)
    - if (messages.warning)
        - const warningText = Array.isArray(messages.warning) ? messages.warning.join(". ") : messages.warning
        +flash-item("warning", "Cảnh báo", warningText, time)
