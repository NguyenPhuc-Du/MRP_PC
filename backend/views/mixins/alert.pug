mixin alert-success(time)
    - if(messages.success)
        .message.info
            div(
                class="alert alert-success"
                show-alert
                data-time = time
            )
                .alert-icon
                    i.bi.bi-check-lg
                .alert-body
                    .alert-title Thành công
                    .alert-text #{messages.success}
                span.alert-close(close-alert)
                    i.bi.bi-x-lg
                .alert-progress(style=`animation-duration:${time}ms`)

