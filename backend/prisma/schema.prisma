generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums (đúng giá trị trong tài liệu thiết kế) ---

enum AccountRole {
  admin
  warehouse_manager
  staff
}

enum AccountStatus {
  active
  locked
}

enum ComponentStatus {
  active
  discontinued
}

enum AttributeDataType {
  text
  integer
  decimal
  boolean
}

enum PcConfigStatus {
  active
  inactive
}

enum ImportOrderStatus {
  draft
  confirmed
}

enum ExportOrderType {
  material
  finished_product
}

enum ExportOrderStatus {
  pending
  approved
  rejected
}

enum ProductionOrderStatus {
  pending
  in_progress
  done
}

// --- Nhóm 1: Người dùng & phân quyền ---

model Account {
  id           Int           @id @default(autoincrement())
  username     String        @unique @db.VarChar(50)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  fullName     String?       @map("full_name") @db.VarChar(100)
  email        String?       @unique @db.VarChar(100)
  phone        String?       @db.VarChar(20)
  role         AccountRole
  status       AccountStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime?     @updatedAt @map("updated_at")

  importOrdersCreated      ImportOrder[]      @relation("ImportOrderCreatedBy")
  exportOrdersRequested    ExportOrder[]      @relation("ExportOrderRequestedBy")
  exportOrdersApproved     ExportOrder[]      @relation("ExportOrderApprovedBy")
  productionOrdersAssigned ProductionOrder[]  @relation("ProductionOrderAssignedTo")
  productionOrdersCreated  ProductionOrder[]  @relation("ProductionOrderCreatedBy")
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]

  @@map("accounts")
}

model Role {
  id          AccountRole @id
  permissions String[]    @default([])
  updatedAt   DateTime?   @updatedAt @map("updated_at")

  @@map("roles")
}

// --- Nhóm 2: Danh mục, BOM & thuộc tính (EAV) ---

model ComponentCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  components            Component[]
  attributeDefinitions  AttributeDefinition[]

  @@map("component_categories")
}

model Component {
  id                 Int             @id @default(autoincrement())
  categoryId         Int             @map("category_id")
  name               String          @db.VarChar(150)
  unit               String?         @db.VarChar(20)
  unitPrice          Decimal         @map("unit_price") @db.Decimal(12, 2)
  minStockThreshold  Int             @default(5) @map("min_stock_threshold")
  imageUrl           String?         @map("image_url") @db.VarChar(500)
  brandId    Int? @map("brand_id")
  supplierId Int? @map("supplier_id")
  status             ComponentStatus @default(active)
  createdAt          DateTime        @default(now()) @map("created_at")

  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)


  category             ComponentCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attributes           ComponentAttribute[]
  bomItems             BomItem[]
  inventory            Inventory?
  importOrderItems     ImportOrderItem[]
  exportOrderItems     ExportOrderItem[]

  @@index([categoryId])
  @@map("components")
  @@index([brandId])
@@index([supplierId])
}

model AttributeDefinition {
  id         Int               @id @default(autoincrement())
  categoryId Int               @map("category_id")
  name       String            @db.VarChar(50)
  dataType   AttributeDataType @map("data_type")
  unit       String?           @db.VarChar(20)
  isRequired Boolean           @default(false) @map("is_required")

  category   ComponentCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  values     ComponentAttribute[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("attribute_definitions")
}

model ComponentAttribute {
  id                    Int    @id @default(autoincrement())
  componentId           Int    @map("component_id")
  attributeDefinitionId Int    @map("attribute_definition_id")
  value                 String @db.VarChar(255)

  component             Component           @relation(fields: [componentId], references: [id], onDelete: Cascade)
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([componentId, attributeDefinitionId])
  @@index([componentId])
  @@index([attributeDefinitionId])
  @@map("component_attributes")
}

model PcConfig {
  id          Int            @id @default(autoincrement())
  name        String         @db.VarChar(100)
  description String?        @db.Text
  salePrice   Decimal        @map("sale_price") @db.Decimal(12, 2)
  status      PcConfigStatus @default(active)
  createdAt   DateTime       @default(now()) @map("created_at")

  bomItems           BomItem[]
  exportOrderItems   ExportOrderItem[]
  productionOrders   ProductionOrder[]

  @@map("pc_configs")
}

model BomItem {
  id          Int @id @default(autoincrement())
  pcConfigId  Int @map("pc_config_id")
  componentId Int @map("component_id")
  quantity    Int

  pcConfig  PcConfig  @relation(fields: [pcConfigId], references: [id], onDelete: Cascade)
  component Component @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([pcConfigId, componentId])
  @@index([pcConfigId])
  @@index([componentId])
  @@map("bom_items")
}

// --- Nhóm 3: Kho vận ---

model Inventory {
  id              Int      @id @default(autoincrement())
  componentId     Int      @unique @map("component_id")
  quantityOnHand  Int      @default(0) @map("quantity_on_hand")
  updatedAt       DateTime @updatedAt @map("updated_at")

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model ImportOrder {
  id         Int               @id @default(autoincrement())
  supplierId Int?              @map("supplier_id")   // tạm optional vì còn 3 phiếu cũ
  code       String            @unique @db.VarChar(30)
  createdBy  Int               @map("created_by")
  note       String?           @db.Text
  status     ImportOrderStatus @default(confirmed)
  createdAt  DateTime          @default(now()) @map("created_at")
  creator  Account           @relation("ImportOrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  items    ImportOrderItem[]
  supplier Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  @@index([createdBy])
  @@index([supplierId])
  @@map("import_orders")
}
model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(100)
  address   String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  components   Component[]
  importOrders ImportOrder[]
  @@map("suppliers")
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  components Component[]
  @@map("brands")
}

model ImportOrderItem {
  id            Int     @id @default(autoincrement())
  importOrderId Int     @map("import_order_id")
  componentId   Int     @map("component_id")
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(12, 2)

  importOrder ImportOrder @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  component   Component   @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@index([importOrderId])
  @@index([componentId])
  @@map("import_order_items")
}

model ExportOrder {
  id          Int               @id @default(autoincrement())
  code        String            @unique @db.VarChar(30)
  type        ExportOrderType
  requestedBy Int               @map("requested_by")
  approvedBy  Int?              @map("approved_by")
  status      ExportOrderStatus @default(pending)
  note        String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  approvedAt  DateTime?         @map("approved_at")

  requester Account            @relation("ExportOrderRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  approver  Account?           @relation("ExportOrderApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  items     ExportOrderItem[]

  @@index([requestedBy])
  @@index([approvedBy])
  @@map("export_orders")
}

model ExportOrderItem {
  id            Int  @id @default(autoincrement())
  exportOrderId Int  @map("export_order_id")
  componentId   Int? @map("component_id")
  pcConfigId    Int? @map("pc_config_id")
  quantity      Int

  exportOrder ExportOrder @relation(fields: [exportOrderId], references: [id], onDelete: Cascade)
  component   Component?  @relation(fields: [componentId], references: [id], onDelete: Restrict)
  pcConfig    PcConfig?   @relation(fields: [pcConfigId], references: [id], onDelete: Restrict)

  @@index([exportOrderId])
  @@index([componentId])
  @@index([pcConfigId])
  @@map("export_order_items")
}

// --- Nhóm 4: Sản xuất ---

model ProductionOrder {
  id                Int                   @id @default(autoincrement())
  pcConfigId        Int                   @map("pc_config_id")
  quantityRequested Int                   @map("quantity_requested")
  assignedTo        Int?                  @map("assigned_to")
  status            ProductionOrderStatus @default(pending)
  createdBy         Int                   @map("created_by")
  createdAt         DateTime              @default(now()) @map("created_at")
  completedAt       DateTime?             @map("completed_at")

  pcConfig PcConfig @relation(fields: [pcConfigId], references: [id], onDelete: Restrict)
  assignee Account? @relation("ProductionOrderAssignedTo", fields: [assignedTo], references: [id], onDelete: Restrict)
  creator  Account  @relation("ProductionOrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([pcConfigId])
  @@index([assignedTo])
  @@index([createdBy])
  @@map("production_orders")
}

// --- Nhóm 5: Hỗ trợ kỹ thuật ---

model RefreshToken {
  id        Int      @id @default(autoincrement())
  accountId Int      @map("account_id")
  token     String   @db.VarChar(500)
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([token])
  @@map("refresh_tokens")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  accountId   Int      @map("account_id")
  action      String   @db.VarChar(100)
  targetTable String?  @map("target_table") @db.VarChar(50)
  targetId    Int?     @map("target_id")
  detail      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([createdAt])
  @@map("audit_logs")
}
